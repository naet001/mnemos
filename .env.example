# Mnemos — Environment Configuration
# Copy this file to .env and fill in your values.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://mnemos:mnemos@localhost:5432/mnemos

# Transport
MNEMOS_TRANSPORT=stdio

# HTTP transport (only used when MNEMOS_TRANSPORT=http or both)
HTTP_HOST=0.0.0.0
HTTP_PORT=3100
HTTP_PATH=/mcp
HTTP_AUTH_MODE=none

# Embedding provider
# none = keyword-only retrieval; fake = deterministic lexical stand-in (384 dims)
# Real adapters (local or hosted models) land here as further milestones allow.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384

# Extraction provider
EXTRACTION_PROVIDER=none
EXTRACTION_MODEL=

# Limits
DEFAULT_CONTEXT_LIMIT=20
DEFAULT_SEARCH_LIMIT=20
PROPOSAL_TTL=604800